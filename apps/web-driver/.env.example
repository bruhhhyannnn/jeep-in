# Same Firebase values as the commuter web app's .env.local (apps/web-commuter).
# Copy this file to .env.local and fill it in. Never commit .env.local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: "true" uses the local Auth and Firestore emulators instead of the live project.
VITE_FIREBASE_EMULATORS=
